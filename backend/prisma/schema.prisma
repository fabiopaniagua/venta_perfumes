datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(uuid())
  name        String
  brand       String
  description String
  price       Float
  aromaType   String      // Amaderado, Cítrico, Floral, Oriental, Fresco
  gender      String      // Hombre, Mujer, Unisex
  occasion    String      // Diario, Citas / Noche, Fiesta, Formal, Deporte
  intensity   String      // Sutil, Moderada, Intensa
  topNotes    String      // Notas de salida
  heartNotes  String      // Notas de corazón
  baseNotes   String      // Notas de fondo
  volumeMl          Int         @default(100)
  imageUrl          String
  stock             Int         @default(25)
  rating            Float       @default(4.8)
  isFeatured        Boolean     @default(false)
  status            String      @default("ACTIVE") // ACTIVE, DRAFT, INACTIVE
  category          String      @default("Perfumes")
  concentration     String      @default("Eau de Parfum")
  lowStockThreshold Int         @default(5)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Sample {
  id           String        @id @default(uuid())
  name         String
  brand        String
  aromaType    String        // Amaderado, Cítrico, Floral, Oriental, Fresco
  description  String
  volumeMl     Int           @default(2)
  imageUrl     String
  stock        Int           @default(100)
  isAvailable  Boolean       @default(true)
  orderSamples OrderSample[]
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  subtotal        Float
  total           Float
  status          String        @default("COMPLETADO")
  createdAt       DateTime      @default(now())
  items           OrderItem[]
  samples         OrderSample[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model OrderSample {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sampleId String
  sample   Sample @relation(fields: [sampleId], references: [id])
}

model StoreSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

